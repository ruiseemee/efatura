# Base de dados PostgreSQL
DATABASE_URL="postgresql://efatura:seemee@localhost:5432/efatura?schema=public"

# Chave de 32 bytes (base64) usada para cifrar segredos (senhas dos subutilizadores, certificado da AT) na BD.
# Gerar com:  openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# URL pública da aplicação (usada para validar a origem dos pedidos)
APP_URL="http://localhost:3000"

# Porta HTTP
PORT=3000

# Administrador inicial criado pelo seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Descarga automática diária (mês corrente e anterior de todas as empresas ativas).
# AUTO_SYNC="off" desliga-a; AUTO_SYNC_HOUR é a hora de Lisboa a partir da qual corre.
AUTO_SYNC="on"
AUTO_SYNC_HOUR=6
